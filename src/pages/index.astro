
---
import Layout from "../layouts/Layout.astro";
import Tarjeta from "../components/Tarjeta.astro";
---

<Layout titulo="Inicio">
  <section class="hero">
    <div class="hero-contenido">
      <p class="etiqueta">ARTE · CULTURA · COMUNIDAD</p>
      <h1>La creatividad nos une</h1>
      <p>
        Descubre un espacio donde el arte, la cultura
        y las personas se encuentran para crear algo único.
      </p>
      <a class="boton" href="/talleres">Explorar talleres</a>
    </div>
  </section>

  <section class="contenido">
    <p class="etiqueta">DESCUBRE LUMEN</p>
    <h2>Un lugar para expresarte</h2>
    <p>
      Creemos que todas las personas tienen algo creativo
      que compartir. Por eso ofrecemos actividades para
      aprender, experimentar y conectar con otros.
    </p>

    <div class="tarjetas">
      <Tarjeta
        titulo="Arte y pintura"
        descripcion="Experimenta con colores, dibujos y técnicas artísticas."
      />
      <Tarjeta
        titulo="Música"
        descripcion="Descubre sonidos, ritmos y nuevas formas de expresión."
      />
      <Tarjeta
        titulo="Fotografía"
        descripcion="Aprende a capturar momentos y contar historias."
      />
    </div>

    <div class="llamada">
      <h2>Tu próxima idea comienza aquí</h2>
      <p>Ven a conocer nuestras actividades culturales.</p>
      <a class="boton" href="/nosotros">Conócenos</a>
    </div>
  </section>
</Layout>