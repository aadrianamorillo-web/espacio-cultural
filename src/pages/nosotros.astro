
---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Nosotros">
  <section class="nosotros">
    <h1>Sobre nosotros</h1>

    <p>
      Lumen Cultural es una organización ficticia dedicada a promover
      el arte, la cultura y la creatividad.
    </p>

    <h2>Nuestra misión</h2>
    <p>
      Acercar el arte a las personas mediante talleres y actividades
      culturales para toda la comunidad.
    </p>

    <h2>Nuestra visión</h2>
    <p>
      Crear un espacio inclusivo donde todos puedan aprender,
      expresarse y compartir sus talentos.
    </p>
  </section>
</Layout>

<style>
  .nosotros {
    max-width: 900px;
    margin: auto;
    padding: 50px 25px;
    line-height: 1.8;
  }

  h1, h2 {
    color: #956b35;
  }
</style>