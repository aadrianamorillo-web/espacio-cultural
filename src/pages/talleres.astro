
---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Talleres">
  <section class="talleres">
    <h1>Nuestros talleres</h1>
    <p>Descubre nuevas actividades para desarrollar tu creatividad.</p>

    <div class="tarjetas">
      <article class="tarjeta">
        <h2>Pintura</h2>
        <p>Aprende técnicas de dibujo, colores y pintura.</p>
      </article>

      <article class="tarjeta">
        <h2>Música</h2>
        <p>Explora ritmos, sonidos y expresión musical.</p>
      </article>

      <article class="tarjeta">
        <h2>Fotografía</h2>
        <p>Aprende a capturar momentos e historias.</p>
      </article>

      <article class="tarjeta">
        <h2>Teatro</h2>
        <p>Desarrolla tu imaginación y expresión corporal.</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .talleres {
    max-width: 1100px;
    margin: auto;
    padding: 50px 20px;
    text-align: center;
  }

  .tarjetas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 30px;
  }

  .tarjeta {
    padding: 25px;
    background: white;
    border: 1px solid #ddd;
    border-radius: 10px;
  }

  .tarjeta h2 {
    color: #956b35;
  }

  @media (max-width: 600px) {
    .tarjetas {
      grid-template-columns: 1fr;
    }
  }
</style>