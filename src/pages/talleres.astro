
---
import Layout from "../layouts/Layout.astro";
import Tarjeta from "../components/Tarjeta.astro";
---

<Layout titulo="Talleres">
  <section class="encabezado-pagina">
    <p class="etiqueta">APRENDE · CREA · COMPARTE</p>
    <h1>Nuestros talleres</h1>
    <p>
      Encuentra tu pasión y desarrolla nuevas habilidades
      en un ambiente creativo y colaborativo.
    </p>
  </section>

  <section class="contenido">
    <h2>Actividades para descubrir</h2>

    <div class="tarjetas">
      <Tarjeta
        titulo="Pintura y dibujo"
        descripcion="Explora colores, técnicas de dibujo y pintura. Ideal para desarrollar tu creatividad."
      />
      <Tarjeta
        titulo="Fotografía creativa"
        descripcion="Aprende composición, iluminación y cómo contar historias a través de imágenes."
      />
      <Tarjeta
        titulo="Música y ritmo"
        descripcion="Descubre instrumentos, experimenta con sonidos y disfruta creando música."
      />
      <Tarjeta
        titulo="Teatro y expresión"
        descripcion="Trabaja la expresión corporal, la imaginación y la interpretación en grupo."
      />
      <Tarjeta
        titulo="Cerámica artesanal"
        descripcion="Crea piezas únicas con tus manos y conoce diferentes técnicas artesanales."
      />
      <Tarjeta
        titulo="Escritura creativa"
        descripcion="Inventa historias, desarrolla personajes y expresa tus ideas a través de las palabras."
      />
    </div>

    <div class="llamada">
      <h2>¡Anímate a participar!</h2>
      <p>
        Cada taller es una oportunidad para aprender
        y compartir con la comunidad.
      </p>
      <a class="boton" href="/nosotros">Conoce nuestra organización</a>
    </div>
  </section>
</Layout>